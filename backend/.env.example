# DataDoctor AI — Backend Environment Variables
# Copy this file to .env and fill in your values.
# The app works without OPENAI_API_KEY (uses fallback heuristics).

# OpenAI API key for AI-powered insights, suggestions, and chat
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Maximum CSV upload file size in megabytes (default: 50)
MAX_FILE_SIZE_MB=50
